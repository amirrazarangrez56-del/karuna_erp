{
  "name": "karuna-hotel-pos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lightning-fast Offline Multi-Terminal Hotel POS & ERP Suite for Karuna Hotel",
  "main": "electron/main.js",
  "scripts": {
    "server": "node server/server.js",
    "dev:frontend": "vite",
    "dev": "concurrently -k -n \"DB-SERVER,VITE-UI\" -c \"bgBlue.bold,bgGreen.bold\" \"node server/server.js\" \"vite\"",
    "desktop:server": "node launcher.js",
    "desktop:counter": "node counter_launcher.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/pos_qa_test_suite.mjs",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron electron/main.js\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "express": "^5.2.1",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3",
    "wait-on": "^8.0.2"
  }
}
